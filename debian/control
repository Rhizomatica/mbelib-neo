Package: libmbe-neo-dev
Section: libdevel
Architecture: any
Multi-Arch: same
Depends:
 libmbe-neo2 (= ${binary:Version}),
 ${misc:Depends},
Description: IMBE/AMBE vocoder library (development files)
 mbelib-neo decodes and encodes the IMBE and AMBE voice codecs used by
 digital voice radio: D-STAR, DMR, P25, NXDN, dPMR and others.
 .
 This package contains the headers, the static library and the pkg-config
 file.

